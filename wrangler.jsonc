{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard.
  "name": "ramjan-ali-tracker",
  // worker.ts wraps the OpenNext build output (.open-next/worker.js, created by
  // `npm run build`) and adds the /admin dashboard backend and its cron.
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // OpenNext calls the Worker itself through this binding, so it must
      // name this same Worker.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "ramjan-ali-tracker"
    }
  ],
  // The /admin dashboard's database: one SQLite-backed Durable Object.
  "durable_objects": {
    "bindings": [{ "name": "ADMIN_STORE", "class_name": "AdminStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AdminStore"] }],
  // Every 5 minutes: publish due posts, send outreach emails, pull in replies.
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true }
}
