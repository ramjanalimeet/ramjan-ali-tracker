{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard.
  "name": "ramjan-ali-tracker",
  // worker.ts wraps the OpenNext build output (.open-next/worker.js, created by
  // `npm run build`) and adds the /admin dashboard backend and its cron.
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Keep the former hostname available so worker.ts can permanently redirect
  // every old URL to the matching URL on the new canonical domain.
  "workers_dev": true,
  // Both hostnames reach this Worker. worker.ts permanently redirects www to
  // the apex so search engines see one canonical production host.
  "routes": [
    { "pattern": "ramjanaliakash.com", "custom_domain": true },
    { "pattern": "www.ramjanaliakash.com", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // OpenNext calls the Worker itself through this binding, so it must
      // name this same Worker.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "ramjan-ali-tracker"
    }
  ],
  // The /admin dashboard's database: one SQLite-backed Durable Object.
  "durable_objects": {
    "bindings": [{ "name": "ADMIN_STORE", "class_name": "AdminStore" }]
  },
  "send_email": [{ "name": "EMAIL" }],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AdminStore"] }],
  "previews": {
    "durable_objects": {
      "bindings": [{ "name": "ADMIN_STORE", "class_name": "AdminStore" }]
    }
  },
  // Every 5 minutes: send outreach emails and pull in replies.
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true }
}
